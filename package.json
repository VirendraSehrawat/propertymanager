    "typecheck": "tsc --noEmit",
    "deploy:vercel": "npx vercel --prod"
  },
  "dependencies": {
    "firebase": "^12.12.1",
    "firebase-admin": "^14.2.0",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
