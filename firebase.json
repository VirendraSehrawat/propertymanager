{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1"
    }
  },
  "apphosting": {
    "backendId": "property-manager",
    "rootDir": "/",
    "ignore": [
